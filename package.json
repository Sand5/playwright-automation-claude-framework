{
  "name": "playwright-automation-claude-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bddgen": "bddgen",
    "report:cucumber": "tsx scripts/generate-cucumber-report.ts",
    "test:all": "bddgen && playwright test",
    "test:chrome:headed": "bddgen && playwright test --project=chromium --headed",
    "test:chrome:headless": "bddgen && playwright test --project=chromium",
    "test:webkit:headless": "bddgen && playwright test --project=webkit",
    "test:login": "bddgen && playwright test --grep @login --project=chromium",
    "test:login:headed": "bddgen && playwright test --grep @login --project=chromium --headed",
    "test:smoke": "bddgen && playwright test --grep @smoke --project=chromium",
    "test:smoke:all": "bddgen && playwright test --grep @smoke",
    "test:tag": "bddgen && playwright test --project=chromium --grep",
    "test:feature": "bddgen && playwright test --project=chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:features": "gherkin-lint features",
    "typecheck": "tsc --noEmit -p .",
    "format:check": "prettier --check scripts step-definitions pages logger test-data config playwright.config.ts",
    "qa:check": "npm run typecheck && npm run lint && npm run lint:features && npm run format:check",
    "review:tests": "claude -p \"/verify-test-outcomes\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "gherkin-lint": "^4.2.4",
    "multiple-cucumber-html-reporter": "^4.6.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@colors/colors": "^1.6.1",
    "dotenv": "^18.0.9",
    "winston": "^3.19.0"
  }
}
