{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "tests/**/*.ts",
    "pages/**/*.ts",
    "logger/**/*.ts",
    "test-data/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
